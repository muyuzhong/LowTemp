{
  "name": "lowtemp-featherlog-plugin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Featherlog external plugin for LowTemp daily timeline notes & git sync.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "install:plugin": "node scripts/install.mjs",
    "build:plugin": "npm run build && npm run install:plugin",
    "build:install": "npm run build:plugin"
  },
  "devDependencies": {
    "@featherlog/contracts": "file:../../Featherlog/packages/contracts",
    "@featherlog/kernel": "file:../../Featherlog/packages/kernel",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
