---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import ArchiveItem from '../components/ArchiveItem.astro';
import ThermoStrip from '../components/ThermoStrip.astro';
import { resolveSiteTemps } from '../lib/temp-resolver';

const allWriting = await getCollection('writing');
const writing = allWriting
  .filter((w) => !w.data.seriesOf)
  .sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const chapterCountMap = new Map<string, number>();
for (const w of allWriting) {
  if (!w.data.seriesOf) continue;
  const key = w.data.seriesOf.toUpperCase();
  chapterCountMap.set(key, (chapterCountMap.get(key) ?? 0) + 1);
}
const siteTemps = await resolveSiteTemps();
const latest = writing.slice(0, 8);
---
<Base title="首页" intro>
  <section class="intro">
    <h1>低温笔记</h1>
    <p class="intro-sub">在噪声退去之后，<br />记录仍然成立的东西。</p>
    <p class="intro-tags">Agent 工程 · Coding Agent · RAG · 系统</p>
    <ThermoStrip entries={writing} temps={siteTemps.writing} />
  </section>

  <section class="section">
    <header class="section-head">
      <h2>最新文章</h2>
      {writing.length > latest.length && <a class="section-more" href="/writing/">全部 {writing.length} 篇</a>}
    </header>
    <ul class="entries">
      {latest.map((e) => (
        <ArchiveItem
          entry={e}
          resolvedTemp={siteTemps.getWriting(e).temp}
          chapterCount={chapterCountMap.get(e.data.id.toUpperCase())}
        />
      ))}
    </ul>
  </section>
</Base>
