---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ArchiveItem from '../../components/ArchiveItem.astro';
import { CATEGORY_LABEL, STATUS_LABEL, STATUS_COLOR, type Status } from '../../lib/temp';

const entries = (await getCollection('writing')).sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime()
);
const cats = Object.keys(CATEGORY_LABEL);

/* 只列出确实存在文章的物态，按温度从低到高 */
const phases = (['stable', 'tested', 'exploring', 'draft', 'deprecated'] as Status[]).filter((s) =>
  entries.some((e) => e.data.status === s)
);
---
<Base title="文章" description="完整结论、探索笔记、建造记录，以及少量别的。">
  <header class="page-head">
    <div class="page-kicker"><span>文章</span><span>共 {entries.length} 篇</span></div>
    <h1>文章</h1>
    <p class="page-sub">完整结论、探索笔记、建造记录，以及少量别的。</p>
  </header>

  <div class="filters" id="filters">
    <div class="filter-line" data-group="cat" role="group" aria-label="按主题过滤">
      <span class="filter-label">主题</span>
      <button type="button" class="chip active" data-value="all">全部</button>
      {cats.map((c) => <button type="button" class="chip" data-value={c}>{CATEGORY_LABEL[c]}</button>)}
    </div>
    <div class="filter-line" data-group="phase" role="group" aria-label="按物态过滤">
      <span class="filter-label">物态</span>
      <button type="button" class="chip active" data-value="all">全部</button>
      {phases.map((s) => (
        <button type="button" class="chip" data-value={s}>
          <i class="temp-dot" style={`background: ${STATUS_COLOR[s]}`}></i>
          {STATUS_LABEL[s]}
          
        </button>
      ))}
    </div>
  </div>

  <ul class="entries" id="archive">
    {entries.map((e) => <ArchiveItem entry={e} />)}
  </ul>
  <p id="empty-state" class="empty" hidden>所选主题与物态的交集下暂无记录。</p>

  <script>
    /* 主题 × 物态 双维过滤（纯前端，不改路由） */
    document.addEventListener('astro:page-load', () => {
      const root = document.getElementById('filters');
      if (!root) return;
      const items = document.querySelectorAll<HTMLElement>('#archive .entry');
      const empty = document.getElementById('empty-state');
      const active = { cat: 'all', phase: 'all' };

      const apply = () => {
        let visible = 0;
        items.forEach((it) => {
          const ok =
            (active.cat === 'all' || it.dataset.category === active.cat) &&
            (active.phase === 'all' || it.dataset.status === active.phase);
          it.hidden = !ok;
          if (ok) visible++;
        });
        if (empty) empty.hidden = visible > 0;
      };

      root.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.chip');
        const line = btn?.closest<HTMLElement>('.filter-line');
        if (!btn || !line) return;
        line.querySelectorAll('.chip').forEach((c) => c.classList.toggle('active', c === btn));
        active[line.dataset.group as 'cat' | 'phase'] = btn.dataset.value || 'all';
        apply();
      });
    });
  </script>
</Base>
