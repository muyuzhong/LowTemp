---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import {
  fmtDate, fmtTemp, tempOf, STATUS_LABEL, STATUS_COLOR, CATEGORY_LABEL,
} from '../../lib/temp';
import { buildRefMap, findLogMentions, parseDailyLogs } from '../../lib/log';

export async function getStaticPaths() {
  const entries = await getCollection('writing');
  const sorted = entries.sort((a, b) => a.data.published.getTime() - b.data.published.getTime());
  return sorted.map((entry, i) => ({
    params: { id: entry.id },
    props: { entry, prev: sorted[i - 1], next: sorted[i + 1] },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const d = entry.data;
const temp = tempOf(d.status, d.temperature);
const h2s = headings.filter((h) => h.depth === 2);
const parts = d.parts && d.parts.length > 1 ? d.parts : null;
const pad2 = (n: number) => String(n).padStart(2, '0');

/* 根据正文动态估算阅读时间(CJK 350 字/分,代码及英文 180 词/分) */
const calcReadingMinutes = (text: string) => {
  const clean = text.replace(/```[\s\S]*?```/g, '').trim();
  const cjk = (clean.match(/[一-龥]/g) || []).length;
  const en = (clean.match(/[a-zA-Z0-9_\-]+/g) || []).length;
  return Math.max(1, Math.round(cjk / 350 + en / 180));
};
const readMinutes = d.minutes ?? (entry.body ? calcReadingMinutes(entry.body) : 8);

/* 思想脉络与双向反向链接 */
const allWriting = await getCollection('writing');
const allProjects = await getCollection('projects');
const allLog = await getCollection('log');
const refMap = buildRefMap(allWriting, allProjects);
const dailyLogs = parseDailyLogs(allLog, refMap);
const logMentions = findLogMentions(dailyLogs, [d.id, entry.id]);

const outgoingNotes = allWriting.filter(
  (o) => o.id !== entry.id && (entry.body?.includes(o.data.id) || entry.body?.includes(o.id))
);
const backlinkNotes = allWriting.filter(
  (o) => o.id !== entry.id && (o.body?.includes(d.id) || o.body?.includes(entry.id))
);
const relatedNotes = allWriting
  .filter(
    (o) =>
      o.id !== entry.id &&
      o.data.category === d.category &&
      !outgoingNotes.some((x) => x.id === o.id) &&
      !backlinkNotes.some((x) => x.id === o.id)
  )
  .slice(0, 2);
const connected = [
  ...backlinkNotes.map((n) => ({ tag: '← 引用了本文', href: `/writing/${n.id}/`, id: n.data.id, title: n.data.title })),
  ...outgoingNotes.map((n) => ({ tag: '延伸 →', href: `/writing/${n.id}/`, id: n.data.id, title: n.data.title })),
  ...relatedNotes.map((n) => ({ tag: '同类 ~', href: `/writing/${n.id}/`, id: n.data.id, title: n.data.title })),
];

const rawMarkdown = `---
id: ${d.id}
title: "${d.title}"
subtitle: "${d.subtitle || ''}"
category: ${d.category}
status: ${d.status}
temperature: ${d.temperature ?? ''}
published: ${d.published.toISOString().split('T')[0]}
${d.updated ? `updated: ${d.updated.toISOString().split('T')[0]}` : ''}
tags: [${(d.tags || []).join(', ')}]
---

${entry.body || ''}
`;
---
<Base
  title={d.title}
  description={d.excerpt}
  article={{ published: d.published, updated: d.updated, tags: d.tags }}
>
  <!-- 阅读温度计：顶部 2px 进度线 + 滚动后出现的阅读条 -->
  <div class="read-line" aria-hidden="true"></div>
  <div class="reading-bar" id="reading-bar" data-temp={temp ?? ''} aria-hidden="true">
    <span class="rb-title">
      <span class="mono">{d.id}</span>
      {parts && <span class="rb-part mono" id="rb-part-badge">PART 01/{pad2(parts.length)}</span>}
      {d.title}
    </span>
    <span class="rb-readout" id="rb-readout">{fmtTemp(temp)} · 0%</span>
    <button type="button" class="rb-focus" id="rb-focus" aria-pressed="true" title="聚焦阅读 (Z)">
      <i class="rb-focus-dot"></i>聚焦
    </button>
  </div>

  {temp != null && (
    <aside class="gauge" id="gauge" aria-hidden="true">
      <div class="gauge-ticks"></div>
      <div class="gauge-fill"></div>
      <div class="gauge-marker"><span id="gauge-readout">{temp.toFixed(1)}°</span></div>
    </aside>
  )}

  <div class="article-layout">
  <article class="content-col" id="post-col">
    <header class="post-head">
      <div class="post-kicker">
        <span>{d.id}</span>
        <span>{CATEGORY_LABEL[d.category]}</span>
        <a href="/about/#temperature" title="了解温度系统">
          <i class="temp-dot" style={`background: ${STATUS_COLOR[d.status]}`}></i>{STATUS_LABEL[d.status]} {fmtTemp(temp)}
        </a>
      </div>
      <h1>{d.title}</h1>
      {d.subtitle && <p class="post-sub">{d.subtitle}</p>}
      <p class="post-facts">
        <time datetime={d.published.toISOString()}>发布 {fmtDate(d.published)}</time>
        {d.updated && <span>更新 {fmtDate(d.updated)}</span>}
        {d.confidence && <span>置信 {d.confidence}</span>}
        {d.scope && <span>范围 {d.scope}</span>}
        {parts && <span>共 {parts.length} 部分</span>}
        <span id="post-read-minutes" data-total-minutes={readMinutes}>{readMinutes} 分钟阅读</span>
      </p>
    </header>

    {parts && (
      <nav class="part-tabs" id="part-tabs" aria-label="文章分篇切换" data-parts={JSON.stringify(parts)}>
        {parts.map((p, idx) => (
          <a
            href={idx === 0 ? `/writing/${entry.id}/` : `/writing/${entry.id}/?part=${idx + 1}`}
            class:list={['part-tab', { active: idx === 0 }]}
            data-part-btn={idx + 1}
            aria-current={idx === 0 ? 'step' : undefined}
          >
            <span class="part-tab-kicker mono">
              <span>PART {pad2(idx + 1)} / {pad2(parts.length)}</span>
              {p.minutes && <span>{p.minutes} MIN</span>}
            </span>
            <span class="part-tab-title">{p.title}</span>
          </a>
        ))}
      </nav>
    )}

    {h2s.length > 1 && (
      <details class="toc" id="mobile-toc">
        <summary id="mobile-toc-summary">目录 · {h2s.length} 节</summary>
        <nav>
          {h2s.map((h) => <a href={`#${h.slug}`} data-slug={h.slug}>{h.text}</a>)}
        </nav>
      </details>
    )}

    <div class="prose" id="prose-content">
      <Content />
    </div>

    {parts && (
      <nav class="part-pager" id="part-pager" aria-label="上下部分阅读导航">
        {parts.map((p, idx) => {
          const prevPart = idx > 0 ? parts[idx - 1] : null;
          const nextPart = idx < parts.length - 1 ? parts[idx + 1] : null;
          return (
            <div class="part-pager-view" data-part-pager={idx + 1} hidden={idx !== 0}>
              <div class="part-pager-bar">
                <span class="part-pager-status mono">
                  PART {pad2(idx + 1)} / {pad2(parts.length)} · {nextPart ? `第 ${idx + 1} 部分已读完` : '全文三部分已读完'}
                </span>
                <div class="part-pager-steps mono" role="group" aria-label="快速跳转章节">
                  {parts.map((_, sIdx) => (
                    <a
                      href={sIdx === 0 ? `/writing/${entry.id}/` : `/writing/${entry.id}/?part=${sIdx + 1}`}
                      class:list={['part-step-dot', { active: sIdx === idx }]}
                      data-part-btn={sIdx + 1}
                      title={`切换到第 ${sIdx + 1} 部分：${parts[sIdx].title}`}
                    >
                      {pad2(sIdx + 1)}
                    </a>
                  ))}
                </div>
              </div>
              <div class:list={['part-pager-grid', { 'only-next': !prevPart }]}>
                {prevPart && (
                  <a
                    href={idx - 1 === 0 ? `/writing/${entry.id}/` : `/writing/${entry.id}/?part=${idx}`}
                    class="part-pager-card prev"
                    data-part-btn={idx}
                  >
                    <span class="part-pager-dir mono">← 上一部分 · PART {pad2(idx)} / {pad2(parts.length)}</span>
                    <span class="part-pager-title">{prevPart.title}</span>
                    {prevPart.subtitle && <span class="part-pager-sub">{prevPart.subtitle}</span>}
                  </a>
                )}
                {nextPart ? (
                  <a
                    href={`/writing/${entry.id}/?part=${idx + 2}`}
                    class="part-pager-card next"
                    data-part-btn={idx + 2}
                  >
                    <span class="part-pager-dir mono">
                      继续阅读下一部分 · PART {pad2(idx + 2)} / {pad2(parts.length)}
                      {nextPart.minutes ? ` · 约 ${nextPart.minutes} 分钟` : ''} →
                    </span>
                    <span class="part-pager-title">{nextPart.title}</span>
                    {nextPart.subtitle && <span class="part-pager-sub">{nextPart.subtitle}</span>}
                  </a>
                ) : (
                  <a
                    href={`/writing/${entry.id}/`}
                    class="part-pager-card next is-restart"
                    data-part-btn={1}
                  >
                    <span class="part-pager-dir mono">全文已读完 · 回到 PART 01 / {pad2(parts.length)} ↺</span>
                    <span class="part-pager-title">重读第一部分：{parts[0].title}</span>
                    {parts[0].subtitle && <span class="part-pager-sub">{parts[0].subtitle}</span>}
                  </a>
                )}
              </div>
            </div>
          );
        })}
      </nav>
    )}

    {parts && (
      <script is:inline data-astro-rerun>
        (function () {
          var prose = document.getElementById('prose-content');
          var tabsEl = document.getElementById('part-tabs');
          if (!prose || !tabsEl) return;
          var partsMeta = [];
          try { partsMeta = JSON.parse(tabsEl.getAttribute('data-parts') || '[]'); } catch (e) {}
          var dividers = Array.prototype.slice.call(prose.querySelectorAll('.part-divider[data-part]'));

          if (dividers.length && !prose.querySelector('.part-pane')) {
            for (var i = 0; i < dividers.length; i++) {
              var div = dividers[i];
              var nextDiv = dividers[i + 1] || null;
              var partNum = parseInt(div.getAttribute('data-part') || String(i + 1), 10);
              var meta = partsMeta[partNum - 1] || {};
              var pane = document.createElement('section');
              pane.className = 'part-pane';
              pane.setAttribute('data-part-pane', String(partNum));

              var lead = document.createElement('div');
              lead.className = 'part-lead';
              lead.setAttribute('data-no-focus', '');
              var totalStr = String(partsMeta.length || dividers.length).padStart(2, '0');
              var curStr = String(partNum).padStart(2, '0');
              var minStr = meta.minutes ? ' · 约 ' + meta.minutes + ' 分钟阅读' : '';
              lead.innerHTML =
                '<div class="part-lead-kicker mono">PART ' + curStr + ' / ' + totalStr + minStr + '</div>' +
                (meta.title ? '<div class="part-lead-title">' + meta.title + '</div>' : '') +
                (meta.subtitle ? '<p class="part-lead-sub">' + meta.subtitle + '</p>' : '');
              pane.appendChild(lead);

              var node = div.nextSibling;
              while (node && node !== nextDiv) {
                var following = node.nextSibling;
                pane.appendChild(node);
                node = following;
              }
              prose.insertBefore(pane, div);
              div.remove();
            }
          }

          var panes = prose.querySelectorAll('.part-pane');
          if (!panes.length) return;
          var params = new URLSearchParams(location.search);
          var reqPart = parseInt(params.get('part') || '1', 10);
          if (location.hash && location.hash.length > 1) {
            try {
              var targetEl = prose.querySelector(decodeURIComponent(location.hash));
              var hostPane = targetEl && targetEl.closest ? targetEl.closest('.part-pane') : null;
              if (hostPane) reqPart = parseInt(hostPane.getAttribute('data-part-pane') || '1', 10);
            } catch (e) {}
          }
          var total = panes.length;
          if (isNaN(reqPart) || reqPart < 1 || reqPart > total) reqPart = 1;

          for (var j = 0; j < panes.length; j++) {
            var pNum = parseInt(panes[j].getAttribute('data-part-pane') || '1', 10);
            panes[j].hidden = pNum !== reqPart;
          }
          var pagers = document.querySelectorAll('.part-pager-view');
          for (var k = 0; k < pagers.length; k++) {
            var pgNum = parseInt(pagers[k].getAttribute('data-part-pager') || '1', 10);
            pagers[k].hidden = pgNum !== reqPart;
          }
        })();
      </script>
    )}

    <div id="quote-bubble" class="quote-bubble" aria-hidden="true">
      <button type="button" id="quote-copy-btn">复制为引文</button>
    </div>

    {d.notes && d.notes.length > 0 && (
      <aside class="notes" aria-label="作者附注">
        <h2 class="block-title">作者附注</h2>
        <ol>
          {d.notes.map((n) => (
            <li>
              <span>{n.anchor}</span>
              <p>{n.text}</p>
            </li>
          ))}
        </ol>
      </aside>
    )}

    {d.tempLog && d.tempLog.length > 1 && (
      <p class="temp-log">
        温度史 — {d.tempLog.map((t) => `${fmtDate(t.date)} ${STATUS_LABEL[t.status]}`).join(' → ')}
      </p>
    )}

    {logMentions.length > 0 && (
      <aside class="log-mentions" aria-label="日常轨迹提及">
        <p class="log-mentions-head">日常轨迹 · 提及 {logMentions.length} 次</p>
        <ul>
          {logMentions.slice(0, 6).map((m) => (
            <li>
              <a href={m.href} class="mono">{m.dateDot}{m.time ? ` ${m.time}` : ''}</a>
              <span class="log-mentions-body" set:html={m.html} />
            </li>
          ))}
        </ul>
      </aside>
    )}

    {connected.length > 0 && (
      <aside class="connected" aria-label="关联笔记">
        <h2 class="block-title">关联笔记</h2>
        <ul>
          {connected.map((c) => (
            <li>
              <a href={c.href}>
                <span class="c-tag">{c.tag}</span>
                <span class="c-id">{c.id}</span>
                <span class="c-title">{c.title}</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    )}

    <nav class="post-nav" aria-label="相邻文章">
      <div>
        {prev && (
          <a href={`/writing/${prev.id}/`}>
            <span class="nav-id">← {prev.data.id}</span>
            {prev.data.title}
          </a>
        )}
      </div>
      <div class="next">
        {next && (
          <a href={`/writing/${next.id}/`}>
            <span class="nav-id">{next.data.id} →</span>
            {next.data.title}
          </a>
        )}
      </div>
    </nav>

    <div class="post-foot">
      <button
        type="button"
        id="export-md-btn"
        data-filename={`${d.id}-${d.title}.md`}
        data-raw-md={encodeURIComponent(rawMarkdown)}
        title="导出本文 Markdown 原文"
      >导出 .md</button>
      <a href="#post-col" id="to-top">回到顶部 ↑</a>
    </div>
  </article>
    {h2s.length > 1 && (
      <nav class="outline" id="outline" aria-label="目录">
        {parts && (
          <div class="outline-parts" id="outline-parts">
            <p class="outline-title">篇章</p>
            {parts.map((p, idx) => (
              <a
                href={idx === 0 ? `/writing/${entry.id}/` : `/writing/${entry.id}/?part=${idx + 1}`}
                class:list={['outline-part-link', { active: idx === 0 }]}
                data-part-btn={idx + 1}
              >
                <span class="mono">{pad2(idx + 1)}</span> {p.title.split(/[：—]/)[0].trim()}
              </a>
            ))}
          </div>
        )}
        <p class="outline-title" id="outline-sec-title">{parts ? '本篇目录' : '目录'}</p>
        {h2s.map((h) => (
          <a href={`#${h.slug}`} data-slug={h.slug}>{h.text}</a>
        ))}
      </nav>
    )}
  </div>

  <script>
    import { initFocusReading } from '../../scripts/focus-reading';

    type Win = Window & { __focusReading?: ReturnType<typeof initFocusReading> };
    let cleanup: (() => void) | undefined;

    function setup(): (() => void) | undefined {
      const prose = document.getElementById('prose-content');
      const col = document.getElementById('post-col');
      if (!prose || !col) return;

      const ac = new AbortController();
      const { signal } = ac;
      const root = document.documentElement;
      const articleTitle = document.querySelector('h1')?.textContent || '';

      /* 0. 导出 Markdown */
      const exportBtn = document.getElementById('export-md-btn');
      exportBtn?.addEventListener('click', () => {
        const md = decodeURIComponent(exportBtn.dataset.rawMd || '');
        const url = URL.createObjectURL(new Blob([md], { type: 'text/markdown;charset=utf-8' }));
        const a = document.createElement('a');
        a.href = url;
        a.download = exportBtn.dataset.filename || 'article.md';
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
        exportBtn.textContent = '已导出 ✓';
        setTimeout(() => (exportBtn.textContent = '导出 .md'), 1800);
      }, { signal });
      document.getElementById('to-top')?.addEventListener('click', (e) => {
        e.preventDefault();
        scrollTo({ top: 0, behavior: 'smooth' });
      }, { signal });

      /* 1. 附注锚点：把正文里第一次出现的锚词标成可悬停的附注 */
      const notes = [...document.querySelectorAll<HTMLElement>('.notes li')].map((li) => ({
        anchor: li.querySelector('span')?.textContent?.trim() || '',
        text: li.querySelector('p')?.textContent?.trim() || '',
      }));
      for (const { anchor, text } of notes) {
        if (!anchor || prose.querySelector(`.sidenote[data-anchor="${CSS.escape(anchor)}"]`)) continue;
        const walker = document.createTreeWalker(prose, NodeFilter.SHOW_TEXT);
        let node: Text | null;
        while ((node = walker.nextNode() as Text | null)) {
          const parent = node.parentElement;
          if (!parent || parent.closest('a, code, pre, h1, h2, h3, svg, figure, [data-no-focus], .sidenote')) continue;
          const idx = node.nodeValue?.indexOf(anchor) ?? -1;
          if (idx < 0 || !node.nodeValue) continue;
          node.splitText(idx + anchor.length);
          const hit = node.splitText(idx);
          const span = document.createElement('span');
          span.className = 'sidenote';
          span.tabIndex = 0;
          span.dataset.anchor = anchor;
          span.dataset.note = text;
          span.textContent = hit.nodeValue;
          hit.replaceWith(span);
          break;
        }
      }

      /* 2. 阅读温度：进度线 / 阅读条 / 章节 scroll-spy（阅读线与聚焦阅读一致，在视口 40% 处） */
      const bar = document.getElementById('reading-bar');
      const readout = document.getElementById('rb-readout');
      const initialTemp = parseFloat(bar?.dataset.temp ?? '');
      const gauge = document.getElementById('gauge');
      const gaugeReadout = document.getElementById('gauge-readout');
      if (gauge && !Number.isNaN(initialTemp) && !gauge.querySelector('.gauge-label')) {
        /* 刻度标签:初温 → 初温 − 2°C,五等分 */
        for (let k = 0; k <= 4; k++) {
          const label = document.createElement('span');
          label.className = 'gauge-label';
          label.style.top = `${k * 25}%`;
          label.textContent = (initialTemp - (2 * k) / 4).toFixed(1);
          gauge.appendChild(label);
        }
      }
      const heads = [...prose.querySelectorAll<HTMLElement>('h2')];
      const outlineLinks = [...document.querySelectorAll<HTMLAnchorElement>('#outline a[data-slug]')];
      const mobileTocLinks = [...document.querySelectorAll<HTMLAnchorElement>('#mobile-toc a[data-slug]')];
      let ticking = false;

      const update = () => {
        ticking = false;
        const max = root.scrollHeight - root.clientHeight;
        const p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
        root.style.setProperty('--read-progress', p.toFixed(4));
        bar?.classList.toggle('shown', scrollY > 260);
        gauge?.style.setProperty('--p', p.toFixed(4));
        if (gaugeReadout && !Number.isNaN(initialTemp)) gaugeReadout.textContent = `${(initialTemp - 2 * p).toFixed(1)}°`;
        if (readout) {
          const pct = Math.round(p * 100);
          readout.textContent = Number.isNaN(initialTemp)
            ? `${pct}%`
            : `${(initialTemp - 2 * p).toFixed(1)}°C · ${pct}%`;
        }
        if (outlineLinks.length) {
          const y = innerHeight * 0.4;
          let current = '';
          for (const h of heads) {
            if (!h.offsetParent) continue;
            if (h.getBoundingClientRect().top <= y) current = h.id;
          }
          outlineLinks.forEach((l) => l.classList.toggle('active', l.dataset.slug === current));
        }
      };
      addEventListener('scroll', () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      }, { passive: true, signal });

      /* 2.5 分篇独立翻页（一篇多部分文章：每部分独立一页，文末可看下一部分） */
      const tabsEl = document.getElementById('part-tabs');
      const initDividers = [...prose.querySelectorAll<HTMLElement>('.part-divider[data-part]')];
      if (initDividers.length && tabsEl && !prose.querySelector('.part-pane')) {
        let partsMeta: { title?: string; subtitle?: string; minutes?: number }[] = [];
        try {
          partsMeta = JSON.parse(tabsEl.getAttribute('data-parts') || '[]');
        } catch (_) {}
        for (let i = 0; i < initDividers.length; i++) {
          const div = initDividers[i];
          const nextDiv = initDividers[i + 1] || null;
          const partNum = parseInt(div.getAttribute('data-part') || String(i + 1), 10);
          const meta = partsMeta[partNum - 1] || {};
          const pane = document.createElement('section');
          pane.className = 'part-pane';
          pane.setAttribute('data-part-pane', String(partNum));

          const lead = document.createElement('div');
          lead.className = 'part-lead';
          lead.setAttribute('data-no-focus', '');
          const totalStr = String(partsMeta.length || initDividers.length).padStart(2, '0');
          const curStr = String(partNum).padStart(2, '0');
          const minStr = meta.minutes ? ` · 约 ${meta.minutes} 分钟阅读` : '';
          lead.innerHTML =
            `<div class="part-lead-kicker mono">PART ${curStr} / ${totalStr}${minStr}</div>` +
            (meta.title ? `<div class="part-lead-title">${meta.title}</div>` : '') +
            (meta.subtitle ? `<p class="part-lead-sub">${meta.subtitle}</p>` : '');
          pane.appendChild(lead);

          let node = div.nextSibling;
          while (node && node !== nextDiv) {
            const following = node.nextSibling;
            pane.appendChild(node);
            node = following;
          }
          prose.insertBefore(pane, div);
          div.remove();
        }
      }

      const panes = [...prose.querySelectorAll<HTMLElement>('.part-pane')];
      if (panes.length > 1) {
        const pagerViews = [...document.querySelectorAll<HTMLElement>('.part-pager-view')];
        const partBtns = [...document.querySelectorAll<HTMLElement>('[data-part-btn]')];
        const rbBadge = document.getElementById('rb-part-badge');
        const mobileTocSummary = document.getElementById('mobile-toc-summary');
        const pad = (n: number) => String(n).padStart(2, '0');

        /* 标记每个 h2 归属哪个 part */
        for (const link of [...outlineLinks, ...mobileTocLinks]) {
          const slug = link.dataset.slug;
          if (!slug) continue;
          const hEl = prose.querySelector<HTMLElement>(`#${CSS.escape(slug)}`);
          const hostPane = hEl?.closest<HTMLElement>('.part-pane');
          if (hostPane?.dataset.partPane) {
            link.dataset.partOf = hostPane.dataset.partPane;
          }
        }

        const activatePart = (partNum: number, opts?: { pushUrl?: boolean; scroll?: boolean }) => {
          const total = panes.length;
          const target = Math.max(1, Math.min(total, partNum));
          const targetStr = String(target);

          panes.forEach((p) => {
            p.hidden = p.dataset.partPane !== targetStr;
          });
          pagerViews.forEach((v) => {
            v.hidden = v.dataset.partPager !== targetStr;
          });
          partBtns.forEach((b) => {
            const isMatch = b.dataset.partBtn === targetStr;
            b.classList.toggle('active', isMatch);
            if (b.classList.contains('part-tab')) {
              if (isMatch) b.setAttribute('aria-current', 'step');
              else b.removeAttribute('aria-current');
            }
          });

          let visibleSecCount = 0;
          outlineLinks.forEach((l) => {
            const show = !l.dataset.partOf || l.dataset.partOf === targetStr;
            l.hidden = !show;
            if (show) visibleSecCount++;
          });
          mobileTocLinks.forEach((l) => {
            const show = !l.dataset.partOf || l.dataset.partOf === targetStr;
            l.hidden = !show;
          });
          if (mobileTocSummary) {
            mobileTocSummary.textContent = `第 ${target} 部分目录 · ${visibleSecCount} 节`;
          }
          if (rbBadge) {
            rbBadge.textContent = `PART ${pad(target)}/${pad(total)}`;
          }

          if (opts?.pushUrl) {
            const url = new URL(location.href);
            if (target === 1) url.searchParams.delete('part');
            else url.searchParams.set('part', targetStr);
            url.hash = '';
            history.pushState({ part: target }, '', url.pathname + url.search);
          }

          if (opts?.scroll) {
            const anchorEl = tabsEl || col;
            const topY = Math.max(0, anchorEl.getBoundingClientRect().top + window.scrollY - 24);
            window.scrollTo({ top: topY, behavior: 'smooth' });
          }

          update();
          window.dispatchEvent(new Event('resize'));
        };

        /* 根据当前 URL 初始化激活的 part */
        const resolveUrlPart = (): number => {
          if (location.hash && location.hash.length > 1) {
            try {
              const hashEl = prose.querySelector<HTMLElement>(decodeURIComponent(location.hash));
              const hostPane = hashEl?.closest<HTMLElement>('.part-pane');
              if (hostPane?.dataset.partPane) return parseInt(hostPane.dataset.partPane, 10);
            } catch (_) {}
          }
          const q = parseInt(new URLSearchParams(location.search).get('part') || '1', 10);
          return Number.isNaN(q) ? 1 : q;
        };

        activatePart(resolveUrlPart());

        document.addEventListener('click', (e) => {
          if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          const btn = (e.target as HTMLElement)?.closest<HTMLElement>('[data-part-btn]');
          if (btn) {
            const nextP = parseInt(btn.dataset.partBtn || '1', 10);
            if (!Number.isNaN(nextP)) {
              e.preventDefault();
              e.stopPropagation();
              activatePart(nextP, { pushUrl: true, scroll: true });
            }
            return;
          }
          /* 点击指向另一 part 内锚点的链接时，先自动切换到该 part */
          const anchor = (e.target as HTMLElement)?.closest<HTMLAnchorElement>('a[href^="#"]');
          if (anchor) {
            const hash = anchor.getAttribute('href');
            if (hash && hash.length > 1) {
              try {
                const targetEl = prose.querySelector<HTMLElement>(decodeURIComponent(hash));
                const hostPane = targetEl?.closest<HTMLElement>('.part-pane');
                if (hostPane && hostPane.hidden && hostPane.dataset.partPane) {
                  activatePart(parseInt(hostPane.dataset.partPane, 10), { pushUrl: true, scroll: false });
                }
              } catch (_) {}
            }
          }
        }, { capture: true, signal });

        window.addEventListener('popstate', () => {
          activatePart(resolveUrlPart(), { pushUrl: false, scroll: true });
        }, { signal });
      }

      update();

      /* 3. 聚焦阅读（自动高亮当前行，上下邻行渐变） */
      const fr = initFocusReading(prose, col);
      (window as Win).__focusReading = fr;
      const focusBtn = document.getElementById('rb-focus') as HTMLButtonElement | null;
      if (focusBtn) {
        if (!fr) {
          focusBtn.hidden = true;
        } else {
          const sync = () => focusBtn.setAttribute('aria-pressed', String(fr.isOn()));
          sync();
          focusBtn.addEventListener('click', () => fr.toggle(), { signal });
          document.addEventListener('focus-reading:change', sync, { signal });
        }
      }

      /* 4. 划词即引文 */
      const bubble = document.getElementById('quote-bubble');
      const copyBtn = document.getElementById('quote-copy-btn');
      if (bubble && copyBtn) {
        let quote = '';
        const hide = () => {
          bubble.classList.remove('visible');
          bubble.setAttribute('aria-hidden', 'true');
        };
        const check = () => {
          const sel = getSelection();
          const text = sel?.toString().trim() ?? '';
          if (text.length >= 4 && sel && sel.rangeCount > 0 && prose.contains(sel.anchorNode)) {
            const rect = sel.getRangeAt(0).getBoundingClientRect();
            if (rect.width > 0) {
              quote = text;
              bubble.style.left = `${Math.max(60, rect.left + rect.width / 2)}px`;
              bubble.style.top = `${Math.max(48, rect.top - 8)}px`;
              bubble.classList.add('visible');
              bubble.setAttribute('aria-hidden', 'false');
              return;
            }
          }
          hide();
        };
        prose.addEventListener('mouseup', () => setTimeout(check, 30), { signal });
        document.addEventListener('selectionchange', () => {
          if (!getSelection()?.toString().trim()) hide();
        }, { signal });
        copyBtn.addEventListener('mousedown', (e) => e.preventDefault(), { signal });
        copyBtn.addEventListener('click', async () => {
          if (!quote) return;
          const md = `> ${quote}\n>\n> —— 暮羽中《${articleTitle}》${location.href}`;
          try {
            await navigator.clipboard.writeText(md);
          } catch (_) {
            const ta = document.createElement('textarea');
            ta.value = md;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            ta.remove();
          }
          copyBtn.textContent = '已复制 ✓';
          setTimeout(() => {
            copyBtn.textContent = '复制为引文';
            hide();
          }, 1200);
        }, { signal });
      }

      return () => {
        ac.abort();
        fr?.destroy();
        (window as Win).__focusReading = null;
        root.style.removeProperty('--read-progress');
      };
    }

    document.addEventListener('astro:page-load', () => {
      cleanup?.();
      cleanup = setup();
    });
    document.addEventListener('astro:before-swap', () => {
      cleanup?.();
      cleanup = undefined;
    });
  </script>
</Base>
