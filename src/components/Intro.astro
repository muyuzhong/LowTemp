---
/* 首页入场:一根弦(src/scripts/intro-string.ts、intro.ts,design.md §2.6)
 * 默认 display:none;Base.astro <head> 的内联脚本在绘制前给 <html> 设 data-intro 才显示,
 * 所以没有 JS 或本会话已经进入过时,首页照常直接出现。
 * 弦线固定在视口正中(画布里画),标题在它上方、标语与提示在它下方。 */
---
<div id="intro" class="intro-gate" role="dialog" aria-modal="true" aria-label="低温笔记">
  <canvas class="intro-canvas" aria-hidden="true"></canvas>
  <p class="intro-title">低温笔记</p>
  <div class="intro-foot">
    <p class="intro-tagline">在噪声退去之后，记录仍然成立的东西。</p>
    <button class="intro-enter mono" type="button">点击进入</button>
  </div>
</div>

<script>
  import { initIntro } from '../scripts/intro';
  initIntro();
</script>
