---
/* 温度尺 — 首页的签名图形。
   一根真正的温度尺:光谱色带(雾 → 结晶)+ 半度细刻度;每篇文章是一根立杆,
   杆顶的圆点颜色 = 物态,杆高只用于错开同温度的文章。越确定,越靠右(越冷)。
   数据即图形,纯 HTML/CSS。hover 杆会弹出站内预览。
   data-max / min / majors 供首页入场的弦对齐刻度(src/scripts/intro.ts)。 */
import { tempOf, fmtTemp, STATUS_COLOR } from '../lib/temp';
import type { CollectionEntry } from 'astro:content';

interface Props { entries: CollectionEntry<'writing'>[] }
const { entries } = Astro.props;

const MAX = 20; // 左端 °C
const MIN = 3; // 右端 °C
const span = MAX - MIN;
const pos = (t: number) => ((MAX - t) / span) * 100;
const majors = [20, 16, 12, 8, 4];
const halfDegrees = Math.round(span * 2);

/* 同温或邻近温度的杆向上错开，避免标签互相重叠或立杆穿字 */
const LABEL_SPAN = 10.2; // 单个标签在色带上的近似占宽百分比
const rawPins = entries
  .map((e) => ({ e, t: tempOf(e.data.status, e.data.temperature) }))
  .filter((x): x is { e: CollectionEntry<'writing'>; t: number } => x.t != null)
  .sort((a, b) => a.e.data.published.getTime() - b.e.data.published.getTime())
  .map(({ e, t }) => {
    const x = pos(t);
    const flip = x > 82;
    const left = flip ? x - LABEL_SPAN : x - 0.8;
    const right = flip ? x + 0.8 : x + LABEL_SPAN;
    return { e, t, x, flip, left, right, n: 0 };
  });

/* 右向标签从右往左排、左向标签从左往右排，使跨过邻杆的标签自然高于邻杆顶点 */
const order = [
  ...rawPins.filter((p) => !p.flip).sort((a, b) => b.x - a.x || a.e.data.published.getTime() - b.e.data.published.getTime()),
  ...rawPins.filter((p) => p.flip).sort((a, b) => a.x - b.x || a.e.data.published.getTime() - b.e.data.published.getTime()),
];
const placed: typeof rawPins = [];
for (const p of order) {
  let n = 0;
  for (const q of placed) {
    /* 若已放置同向邻杆 q 的立杆落在 p 的标签范围内，p 至少高于 q */
    if (q.flip === p.flip && q.x > p.left && q.x < p.right) {
      n = Math.max(n, q.n + 1);
    }
  }
  while (placed.some((q) => q.n === n && Math.max(p.left, q.left) < Math.min(p.right, q.right))) {
    n++;
  }
  p.n = n;
  placed.push(p);
}
const pins = rawPins;
const rows = Math.max(1, ...pins.map((p) => p.n + 1));
---
<div
  class="thermo"
  style={`--rows: ${rows}; --halves: ${halfDegrees}`}
  data-max={MAX}
  data-min={MIN}
  data-majors={majors.join(',')}
  role="group"
  aria-label="文章温度分布"
>
  <div class="thermo-pins">
    {pins.map(({ e, t, n, x, flip }) => (
      <a
        class:list={['thermo-pin', { flip }]}
        href={`/writing/${e.id}/`}
        style={`left: ${x}%; --n: ${n}; --c: ${STATUS_COLOR[e.data.status]}`}
        aria-label={`${e.data.id} ${e.data.title} ${fmtTemp(t)}`}
      >
        <span class="thermo-label">{e.data.id}<em>{fmtTemp(t)}</em></span>
      </a>
    ))}
  </div>
  <div class="thermo-band" aria-hidden="true"></div>
  <div class="thermo-ticks" aria-hidden="true">
    {majors.map((t) => <span class="major" style={`left: ${pos(t)}%`}><b>{t}°</b></span>)}
  </div>
  <div class="thermo-legend" aria-hidden="true">
    <span>草稿 · 雾</span>
    <span>越确定，越冷</span>
    <span>稳定 · 结晶</span>
  </div>
</div>
