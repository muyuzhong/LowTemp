---
/* 低温光谱尺（ThermoStrip） — 首页的签名精密仪器（design.md §1 / §2.6）。
   单根 1px 发丝弦 + 0.5° 矢量刻度 + 谱线立杆，顶栏在静止说明与实时游标读数间零位移切换。
   data-max / min / majors 供首页入场的弦逐像素咬合对齐（src/scripts/intro.ts）。 */
import {
  tempOf,
  fmtTemp,
  STATUS_COLOR,
  STATUS_LABEL,
  STATUS_STATE,
  THERMO_PHASES,
  THERMO_MAX,
  THERMO_MIN,
  THERMO_MAJORS,
} from '../lib/temp';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'writing'>[];
}
const { entries } = Astro.props;

const MAX = THERMO_MAX; // 左端 °C（暖）
const MIN = THERMO_MIN; // 右端 °C（冷）
const span = MAX - MIN;
const pos = (t: number) => ((MAX - t) / span) * 100;
const majors = THERMO_MAJORS;
const halfDegrees = Math.round(span * 2);

/* 按温度从暖到冷排序（20°C → 3°C），使 DOM 顺序与视觉从左到右及键盘 Tab 顺序严格一致 */
const sorted = entries
  .map((e) => ({ e, t: tempOf(e.data.status, e.data.temperature) }))
  .filter((x): x is { e: CollectionEntry<'writing'>; t: number } => x.t != null)
  .sort(
    (a, b) =>
      b.t - a.t ||
      a.e.data.published.getTime() - b.e.data.published.getTime() ||
      a.e.data.id.localeCompare(b.e.data.id)
  );

/* 同温或极近温度（< 0.18°C）拆成对称双线谱（±0.12°C），避免叠成 1px，真实温度读数保持不变 */
const MIN_T = MIN + 0.15;
const MAX_T = MAX - 0.15;
const clampT = (v: number) => Math.max(MIN_T, Math.min(MAX_T, v));
const plotTemps = sorted.map((p) => clampT(p.t));

let idx = 0;
while (idx < sorted.length) {
  let end = idx + 1;
  while (end < sorted.length && sorted[end - 1].t - sorted[end].t < 0.18) {
    end++;
  }
  const count = end - idx;
  if (count > 1) {
    const step = 0.24;
    const halfSpan = ((count - 1) * step) / 2;
    let center = sorted.slice(idx, end).reduce((acc, p) => acc + p.t, 0) / count;
    center = Math.max(MIN_T + halfSpan, Math.min(MAX_T - halfSpan, center));
    for (let k = 0; k < count; k++) {
      plotTemps[idx + k] = clampT(center + ((count - 1) / 2 - k) * step);
    }
  }
  idx = end;
}

const pins = sorted.map(({ e, t }, i) => {
  const x = pos(plotTemps[i]);
  const minutes = e.data.minutes || 8;
  const stemH = 12 + Math.min(5, Math.round(Math.sqrt(minutes)));
  return { e, t, x, stemH };
});

const presentPhases = THERMO_PHASES.filter((s) => pins.some((p) => p.e.data.status === s));
const majorSet = new Set<number>(majors);
---
<div
  class="thermo"
  data-max={MAX}
  data-min={MIN}
  data-majors={majors.join(',')}
  role="group"
  aria-label="文章温度谱"
>
  <div class="thermo-head">
    <div class="thermo-idle">
      <span class="thermo-caption">
        <span>温度谱</span><span class="thermo-caption-sub"> · 越确定，越冷</span>
      </span>
      {presentPhases.length > 0 && (
        <div class="thermo-phases" role="group" aria-label="按物态浏览文章">
          {presentPhases.map((s) => (
            <a
              class="thermo-phase"
              href={`/writing/?phase=${s}`}
              data-phase={s}
              data-no-popover
            >
              <i class="temp-dot" style={`background: ${STATUS_COLOR[s]}`} aria-hidden="true"></i>{STATUS_STATE[s]}
            </a>
          ))}
        </div>
      )}
    </div>

    <div class="thermo-readout" aria-hidden="true">
      <span class="thermo-readout-id mono"></span>
      <span class="thermo-readout-sep">·</span>
      <span class="thermo-readout-title"></span>
      <span class="thermo-readout-meta">
        <i class="temp-dot thermo-readout-dot"></i>
        <span class="thermo-readout-temp"></span>
      </span>
    </div>
  </div>

  <div class="thermo-track">
    <ul class="thermo-pins" role="list">
      {pins.map(({ e, t, x, stemH }) => (
        <li>
          <a
            class="thermo-pin"
            href={`/writing/${e.id}/`}
            data-no-popover
            data-x={x.toFixed(4)}
            data-phase={e.data.status}
            data-id={e.data.id}
            data-title={e.data.title}
            data-status-label={STATUS_LABEL[e.data.status]}
            data-temp={fmtTemp(t)}
            data-color={STATUS_COLOR[e.data.status]}
            style={`left: ${x.toFixed(4)}%; --h: ${stemH}px; --c: ${STATUS_COLOR[e.data.status]}`}
            aria-label={`${e.data.id} ${e.data.title} · ${STATUS_LABEL[e.data.status]} ${fmtTemp(t)}`}
          >
            <i class="thermo-stem" aria-hidden="true"></i>
            <i class="thermo-dot" aria-hidden="true"></i>
          </a>
        </li>
      ))}
    </ul>

    <div class="thermo-band" aria-hidden="true"></div>

    <div class="thermo-ticks" aria-hidden="true">
      <svg class="thermo-ticks-svg" aria-hidden="true" shape-rendering="crispEdges">
        {Array.from({ length: halfDegrees + 1 }, (_, i) => {
          const t = MAX - i * 0.5;
          const pct = pos(t);
          const isMajor = majorSet.has(t);
          return (
            <line
              class:list={[{ major: isMajor }]}
              x1={`${pct.toFixed(4)}%`}
              x2={`${pct.toFixed(4)}%`}
              y1="0"
              y2={isMajor ? 10 : 5}
              data-major={isMajor ? '1' : undefined}
            />
          );
        })}
      </svg>
      {majors.map((t, i) => (
        <span
          class:list={['thermo-tick-label', { 'is-first': i === 0 }]}
          style={`left: ${pos(t).toFixed(4)}%`}
        >
          {i === 0 ? `${t}°C` : `${t}°`}
        </span>
      ))}
    </div>
  </div>
</div>
