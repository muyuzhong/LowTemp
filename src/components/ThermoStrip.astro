---
/* 低温光谱调谐带（ThermoStrip） — 首页的签名精密仪器（design.md §1 / §2.6）。
   纯光栅 0.2°C 对称矢量刻度 + 2px 银盐冷暖灰无框谱线 + 常驻布劳恩三角调谐针。
   SSR 默认停靠在最新发布文章频道，零空白顶栏、零水合跳变。
   data-max / min / majors 与中心基准线 .thermo-band 供入场弦（src/scripts/intro.ts）逐像素咬合。 */
import {
  fmtTemp,
  STATUS_COLOR,
  STATUS_STATE,
  THERMO_PHASES,
  THERMO_MAX,
  THERMO_MIN,
  THERMO_MAJORS,
  type TempBreakdown,
} from '../lib/temp';
import { resolveSiteTemps } from '../lib/temp-resolver';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entries: CollectionEntry<'writing'>[];
  temps?: Map<string, TempBreakdown>;
}
const { entries, temps } = Astro.props;
const siteTemps = temps ? null : await resolveSiteTemps();

const MAX = THERMO_MAX; // 左端 °C（暖）
const MIN = THERMO_MIN; // 右端 °C（冷）
const span = MAX - MIN;
const pos = (t: number) => ((MAX - t) / span) * 100;
const majors = THERMO_MAJORS;
const gratingSteps = Math.round(span / 0.2); // 20.0°C → 3.0°C 共 86 根 0.2°C 光栅线

/* 按温度从暖到冷排序（20°C → 3°C），使 DOM 顺序与视觉从左到右及键盘 Tab 顺序严格一致 */
const sorted = entries
  .map((e) => ({
    e,
    t: temps ? (temps.get(e.id)?.temp ?? null) : siteTemps!.getWriting(e).temp,
  }))
  .filter((x): x is { e: CollectionEntry<'writing'>; t: number } => x.t != null)
  .sort(
    (a, b) =>
      b.t - a.t ||
      a.e.data.published.getTime() - b.e.data.published.getTime() ||
      a.e.data.id.localeCompare(b.e.data.id)
  );

/* 同温或极近温度（< 0.18°C）拆成对称双线谱（±0.12°C），避免叠成单线，真实温度读数保持不变 */
const MIN_T = MIN + 0.15;
const MAX_T = MAX - 0.15;
const clampT = (v: number) => Math.max(MIN_T, Math.min(MAX_T, v));
const plotTemps = sorted.map((p) => clampT(p.t));

let idx = 0;
while (idx < sorted.length) {
  let end = idx + 1;
  while (end < sorted.length && sorted[end - 1].t - sorted[end].t < 0.18) {
    end++;
  }
  const count = end - idx;
  if (count > 1) {
    const step = 0.24;
    const halfSpan = ((count - 1) * step) / 2;
    let center = sorted.slice(idx, end).reduce((acc, p) => acc + p.t, 0) / count;
    center = Math.max(MIN_T + halfSpan, Math.min(MAX_T - halfSpan, center));
    for (let k = 0; k < count; k++) {
      plotTemps[idx + k] = clampT(center + ((count - 1) / 2 - k) * step);
    }
  }
  idx = end;
}

const pins = sorted.map(({ e, t }, i) => ({
  e,
  t,
  x: pos(plotTemps[i]),
  publishedMs: e.data.published.getTime(),
}));

/* 默认停靠在最新发布的一篇文章频道（如 LTN-032） */
let defaultIdx = 0;
for (let i = 1; i < pins.length; i++) {
  if (
    pins[i].publishedMs > pins[defaultIdx].publishedMs ||
    (pins[i].publishedMs === pins[defaultIdx].publishedMs &&
      pins[i].e.data.id.localeCompare(pins[defaultIdx].e.data.id) > 0)
  ) {
    defaultIdx = i;
  }
}
const defaultPin = pins[defaultIdx];
const phaseSet = new Set(THERMO_PHASES.filter((s) => pins.some((p) => p.e.data.status === s)));
---
<div
  class="thermo"
  style={`--pointer-x: ${defaultPin ? defaultPin.x.toFixed(4) : 50}%`}
  data-max={MAX}
  data-min={MIN}
  data-majors={majors.join(',')}
  role="group"
  aria-label="文章温度光谱调谐带"
>
  <div class="thermo-head">
    <a
      class="thermo-readout-link"
      href={defaultPin ? `/writing/${defaultPin.e.id}/` : '/writing/'}
      data-no-popover
    >
      <span class="thermo-readout-id mono">{defaultPin?.e.data.id ?? ''}</span>
      <span class="thermo-readout-title">{defaultPin?.e.data.title ?? ''}</span>
      <span class="thermo-readout-arrow" aria-hidden="true">→</span>
    </a>

    <span class="thermo-readout-meta mono">
      <i
        class="temp-dot thermo-readout-dot"
        style={`background: ${defaultPin ? STATUS_COLOR[defaultPin.e.data.status] : 'var(--phase-exploring)'}`}
        aria-hidden="true"
      ></i>
      <span class="thermo-readout-temp">
        {defaultPin ? `${STATUS_STATE[defaultPin.e.data.status]} · ${fmtTemp(defaultPin.t)}` : ''}
      </span>
    </span>
  </div>

  <div class="thermo-track">
    <div class="thermo-band" aria-hidden="true"></div>
    <i class="thermo-pointer" aria-hidden="true"></i>
    <i class="thermo-ghost" aria-hidden="true"></i>

    <svg class="thermo-ticks-svg" aria-hidden="true" shape-rendering="crispEdges">
      {Array.from({ length: gratingSteps + 1 }, (_, i) => {
        const pct = (i / gratingSteps) * 100;
        const isMajor = i % 20 === 0;
        const isMid = !isMajor && i % 5 === 0;
        const y1 = isMajor ? 6.5 : isMid ? 8.5 : 9.8;
        const y2 = isMajor ? 21.5 : isMid ? 19.5 : 18.2;
        return (
          <line
            class:list={[{ major: isMajor, mid: isMid }]}
            x1={`${pct.toFixed(4)}%`}
            x2={`${pct.toFixed(4)}%`}
            y1={y1}
            y2={y2}
            data-tier={isMajor ? '2' : isMid ? '1' : '0'}
          />
        );
      })}
    </svg>

    <ul class="thermo-pins" role="list">
      {pins.map(({ e, t, x, publishedMs }, i) => (
        <li>
          <a
            class:list={['thermo-pin', { 'is-active': i === defaultIdx }]}
            href={`/writing/${e.id}/`}
            data-no-popover
            data-x={x.toFixed(4)}
            data-published={String(publishedMs)}
            data-phase={e.data.status}
            data-id={e.data.id}
            data-title={e.data.title}
            data-state={STATUS_STATE[e.data.status]}
            data-temp={fmtTemp(t)}
            data-color={STATUS_COLOR[e.data.status]}
            style={`left: ${x.toFixed(4)}%; --c: ${STATUS_COLOR[e.data.status]}`}
            aria-label={`${e.data.id} ${e.data.title} · ${STATUS_STATE[e.data.status]} ${fmtTemp(t)}`}
          >
            <i class="thermo-knockout" aria-hidden="true"></i>
            <i class="thermo-bar" aria-hidden="true"></i>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <div class="thermo-scale">
    <span class="thermo-scale-stop">
      <span class="mono" aria-hidden="true">20°C</span>
      {phaseSet.has('draft') && (
        <a class="thermo-phase" href="/writing/?phase=draft" data-phase="draft" data-no-popover>
          <i class="temp-dot" style={`background: ${STATUS_COLOR.draft}`} aria-hidden="true"></i>{STATUS_STATE.draft}
        </a>
      )}
    </span>

    <span class="thermo-scale-stop">
      <span class="mono" aria-hidden="true">16°</span>
      {phaseSet.has('exploring') && (
        <a class="thermo-phase" href="/writing/?phase=exploring" data-phase="exploring" data-no-popover>
          <i class="temp-dot" style={`background: ${STATUS_COLOR.exploring}`} aria-hidden="true"></i>{STATUS_STATE.exploring}
        </a>
      )}
    </span>

    <span class="thermo-scale-stop" aria-hidden="true">
      <span class="mono">12°</span>
    </span>

    <span class="thermo-scale-stop">
      <span class="mono" aria-hidden="true">8°</span>
      {phaseSet.has('tested') && (
        <a class="thermo-phase" href="/writing/?phase=tested" data-phase="tested" data-no-popover>
          <i class="temp-dot" style={`background: ${STATUS_COLOR.tested}`} aria-hidden="true"></i>{STATUS_STATE.tested}
        </a>
      )}
    </span>

    <span class="thermo-scale-stop">
      {phaseSet.has('stable') && (
        <a class="thermo-phase" href="/writing/?phase=stable" data-phase="stable" data-no-popover>
          <i class="temp-dot" style={`background: ${STATUS_COLOR.stable}`} aria-hidden="true"></i>{STATUS_STATE.stable}
        </a>
      )}
      <span class="mono" aria-hidden="true">4°C</span>
    </span>
  </div>
</div>
