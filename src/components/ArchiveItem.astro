---
import { fmtDate, fmtTemp, tempOf, STATUS_COLOR, STATUS_LABEL, CATEGORY_LABEL } from '../lib/temp';
import type { CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'writing'> }
const { entry } = Astro.props;
const d = entry.data;
const temp = tempOf(d.status, d.temperature);
const deprecated = d.status === 'deprecated';
---
<li class="entry" data-nav-item data-category={d.category} data-status={d.status}>
  <a href={`/writing/${entry.id}/`}>
    <time class="entry-date" datetime={d.published.toISOString()}>{fmtDate(d.published)}</time>
    <div class="entry-main">
      <h3 class:list={['entry-title', { deprecated }]}>{d.title}</h3>
      {d.subtitle && <p class="entry-sub">{d.subtitle}</p>}
      <p class="entry-meta">
        <span>{d.id}</span>
        <span>{CATEGORY_LABEL[d.category]}</span>
        <span class="temp"><i class="temp-dot" style={`background: ${STATUS_COLOR[d.status]}`}></i>{STATUS_LABEL[d.status]} {fmtTemp(temp)}</span>
      </p>
    </div>
  </a>
</li>
