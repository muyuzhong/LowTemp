---
import { getCollection } from 'astro:content';
import { siteTemp, tempOf, fmtTemp } from '../lib/temp';

/* 站点温度 = 全部公开内容温度中位数 */
const writing = await getCollection('writing');
const projects = await getCollection('projects');
const t = siteTemp([
  ...writing.map((e) => tempOf(e.data.status, e.data.temperature)),
  ...projects.map((e) => tempOf(e.data.status, e.data.temperature)),
]);
---
<footer class="site-footer">
  <a class="sys-status" href="/about/#temperature" title="站点温度 = 全部公开内容温度的中位数">
    <span class="breath" aria-hidden="true"></span>
    <span>低温笔记 · 站点 {fmtTemp(t)}</span>
  </a>
  <nav class="footer-nav" aria-label="页脚导航">
    <a href="/rss.xml">RSS</a>
    <a href="https://github.com/muyuzhong" target="_blank" rel="noopener noreferrer">GitHub</a>
  </nav>
</footer>
