---
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Intro from '../components/Intro.astro';
import { STATUS_COLOR, STATUS_LABEL, fmtTemp } from '../lib/temp';
import { resolveSiteTemps } from '../lib/temp-resolver';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  article?: {
    id?: string;
    subtitle?: string;
    categoryLabel?: string;
    published?: Date;
    updated?: Date;
    tags?: string[];
    minutes?: number;
  };
  /** 首页入场动画(见 Intro.astro) */
  intro?: boolean;
}
const {
  title,
  description = '在噪声退去之后，记录仍然成立的东西。',
  ogImage: ogImagePath = '/og.png',
  article,
  intro = false,
} = Astro.props;
const siteOrigin = (Astro.site ?? new URL('https://blog.muyuzhong.xyz')).origin;
const canonical = new URL(Astro.url.pathname, siteOrigin);
const ogImage = new URL(ogImagePath, siteOrigin);

const authorPerson = {
  '@type': 'Person',
  name: '暮羽中',
  url: `${siteOrigin}/about/`,
  sameAs: ['https://github.com/muyuzhong'],
};

const jsonLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      ...(article.subtitle ? { alternativeHeadline: article.subtitle } : {}),
      ...(article.id ? { identifier: article.id } : {}),
      description,
      image: [ogImage.href],
      inLanguage: 'zh-CN',
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical.href },
      url: canonical.href,
      ...(article.published ? { datePublished: article.published.toISOString() } : {}),
      dateModified: (article.updated ?? article.published)?.toISOString(),
      ...(article.categoryLabel ? { articleSection: article.categoryLabel } : {}),
      ...(article.tags?.length ? { keywords: article.tags.join(', ') } : {}),
      ...(article.minutes ? { timeRequired: `PT${article.minutes}M` } : {}),
      author: authorPerson,
      publisher: {
        '@type': 'Organization',
        name: '低温笔记 LowTemp Notes',
        url: `${siteOrigin}/`,
        logo: { '@type': 'ImageObject', url: `${siteOrigin}/favicon.svg` },
      },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: '低温笔记 LowTemp Notes',
      alternateName: 'LowTemp Notes',
      url: `${siteOrigin}/`,
      description,
      inLanguage: 'zh-CN',
      author: authorPerson,
    };
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');

/* 站内文章与项目即刻预览（hover 链接时弹出卡片）的数据 */
const writingList = await getCollection('writing');
const projectList = await getCollection('projects');
const siteTemps = await resolveSiteTemps();
const postPreviews = Object.fromEntries([
  ...writingList.map((p) => [
    `/writing/${p.id}/`,
    {
      id: p.data.id,
      title: p.data.title,
      statusLabel: STATUS_LABEL[p.data.status],
      statusColor: STATUS_COLOR[p.data.status],
      tempStr: fmtTemp(siteTemps.getWriting(p).temp),
      excerpt: p.data.excerpt,
      minutes: p.data.minutes ?? 8,
    },
  ]),
  ...projectList.map((p) => [
    `/projects/#${p.data.id.toLowerCase()}`,
    {
      id: p.data.id,
      title: p.data.title,
      statusLabel: STATUS_LABEL[p.data.status],
      statusColor: STATUS_COLOR[p.data.status],
      tempStr: fmtTemp(siteTemps.getProject(p).temp),
      excerpt: p.data.subtitle || p.data.problem,
      minutes: 0,
      metaRight: p.data.state,
    },
  ]),
]);
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · 低温笔记</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={`${title} · 低温笔记`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} · 低温笔记`} />
    <meta property="og:site_name" content="低温笔记 LowTemp Notes" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} · 低温笔记`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {article && (
      <>
        <meta property="article:author" content="暮羽中" />
        {article.published && <meta property="article:published_time" content={article.published.toISOString()} />}
        {article.updated && <meta property="article:modified_time" content={article.updated.toISOString()} />}
        {article.tags?.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}
    <link rel="alternate" type="application/rss+xml" title="低温笔记" href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="LLMs.txt" href="/llms.txt" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script type="application/ld+json" is:inline set:html={jsonLdText} />
    <script is:inline>
      /* 防闪烁:绘制前恢复主题;没有保存过偏好时跟随系统 */
      (function () {
        var t;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        document.documentElement.dataset.theme =
          t || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
      })();
    </script>
    {intro && (
      <script is:inline>
        /* 入场动画:每个会话一次,?intro 强制重播。必须在绘制前决定,否则首页会先闪一下 */
        (function () {
          var r = document.documentElement;
          var show = /[?&]intro\b/.test(location.search);
          try { show = show || !sessionStorage.getItem('intro-seen'); } catch (e) {}
          if (!show) return;
          r.dataset.intro = 'on';
          /* 兜底:脚本没能接管(加载失败等)时撤掉遮罩,别把人挡在门外 */
          setTimeout(function () { if (!window.__introBound) r.removeAttribute('data-intro'); }, 5000);
        })();
      </script>
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter:wght@400;500;600&family=Noto+Serif+SC:wght@500;600&family=Noto+Sans+SC:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
  </head>
  <body>
    <!-- 背景等温线场(见 src/scripts/bg-field.ts);persist:换页时不重建,动画连续 -->
    <canvas id="bg-field" transition:persist aria-hidden="true"></canvas>
    {intro && <Intro />}
    <div class="frame">
      <SiteHeader />
      <main>
        <slot />
      </main>
      <SiteFooter />
    </div>

    <!-- 站内文章即刻预览 -->
    <div id="link-popover" class="link-popover" aria-hidden="true">
      <div class="popover-meta mono">
        <span id="popover-id"></span>
        <span class="popover-status">
          <span class="popover-dot" id="popover-dot"></span>
          <span id="popover-status-text"></span>
        </span>
        <span id="popover-time"></span>
      </div>
      <div class="popover-title" id="popover-title"></div>
      <div class="popover-excerpt" id="popover-excerpt"></div>
    </div>

    <CommandPalette />

    <script type="application/json" id="post-previews-data" is:inline set:html={JSON.stringify(postPreviews)} />
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
